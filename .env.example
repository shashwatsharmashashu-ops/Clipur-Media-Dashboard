# Clipur Media Command — environment template
#
# Copy to .env.local and adjust. Every value here has a working default, so a
# fresh clone runs with no .env.local at all. Nothing in this file is a secret;
# never commit a real .env.local.
#
#   cp .env.example .env.local


# Where the SQLite database file lives.
# Default: ./data/clipur.db (relative to the project root).
# Set this when the database must live on a mounted volume — which is what a
# hosted deployment needs, since the default path is inside the app directory.
# CLIPUR_DB_PATH=./data/clipur.db


# The shared Drive folder the media team works out of, linked in the header.
# Default: the Clipur content folder hard-coded in lib/config.ts.
# Override it to point a different deployment somewhere else.
# NEXT_PUBLIC_CONTENT_FOLDER_URL=https://drive.google.com/drive/folders/REPLACE_ME


# NODE_ENV is set by the npm scripts (dev / build / start). Do not set it here.
#
# Note: session cookies are marked Secure when NODE_ENV=production, so a
# production deployment must be served over HTTPS or nobody can stay signed in.
